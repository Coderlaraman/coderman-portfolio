generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  fullDescription String   @db.Text
  technologies    Json
  challenges      Json
  results         Json
  imageUrls       Json
  projectUrl      String?
  codeUrl         String?
  order           Int      @default(0)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  category    String
  proficiency Int
  icon        String?
  description String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String
  language  String
  content   String   @db.Text
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, language])
}

model AdminCode {
  id        String   @id @default(cuid())
  code      String
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Resume {
  id         String   @id @default(cuid())
  fullName   String
  title      String
  summary    String   @db.Text
  email      String
  phone      String?
  location   String?
  website    String?
  github     String?
  linkedin   String?
  experience Json
  education  Json
  updatedAt  DateTime @updatedAt
}
