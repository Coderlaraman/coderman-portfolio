// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  fullDescription String   @db.Text
  technologies    Json     // Stored as JSON array of strings
  challenges      Json     // Stored as JSON array of strings
  results         Json     // Stored as JSON array of strings
  imageUrls       Json     // Stored as JSON array of strings
  projectUrl      String?
  codeUrl         String?
  order           Int      @default(0)
  featured        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  category    String   // 'backend' | 'frontend' | 'tools' | 'database' | 'other'
  proficiency Int
  icon        String?
  description String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  read      Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String
  language  String   // 'en' | 'es'
  content   String   @db.Text
  type      String   // 'bio' | 'tagline' | 'section_header' | 'button_text' | 'placeholder'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, language])
}
